{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Anything",
  "version": "0.1.0",
  "identifier": "com.downloadanything.app",
  "build": {
    "beforeDevCommand": "pnpm engines && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm engines && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Download Anything",
        "width": 460,
        "height": 480,
        "minWidth": 380,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "resources": {
      "binaries/licenses/": "licenses/"
    }
  }
}
